{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawdbot",
  "version": "0.1.0",
  "identifier": "com.clawdbot.pet",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:4870",
    "beforeDevCommand": "node tools/dev-server.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "Claw'dbot",
        "width": 160,
        "height": 160,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "rubberdonut67",
    "homepage": "https://github.com/rubberdonut67/clawdbot",
    "shortDescription": "Claw'dbot: a desktop pet that shows what Claude needs",
    "longDescription": "A crab. A robot. A very small colleague. Claw'd sits on your screen and reacts to your Claude Code and Cowork sessions: it works while Claude works, waves a flag when a task finishes, and hops when Claude is waiting on you.",
    "copyright": "Copyright (c) 2026 rubberdonut67",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
